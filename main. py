    uid = str(update.effective_user.id)
    args = context.args

    # نظام الدعوة 1$ لكل شخص
    if args and not args[0].startswith("file_") and args[0] in USERS and args[0]!= uid:
        if uid not in USERS:
            USERS[args[0]]["balance"] += 1.0
            USERS[args[0]]["refs"] += 1
            USERS[args[0]]["earned"] += 1.0
            save_data()
            try: await context.bot.send_message(int(args[0]), f"🎉 شخص جديد دخل عن طريقك! ربحت 1.00$ 💰")
            except: pass

    u = get_user(update.effective_user.id)
    vip_txt = f"👑 VIP حتى {u['expire'][:10]}" if u['vip'] and u['expire'] else "❌ VIP غير مفعل"

    txt = f"""
🔥 **أهلاً {update.effective_user.first_name}!** 🔥

يسعدنا أنك اخترت خدمتنا استمتع معنا ❤️

