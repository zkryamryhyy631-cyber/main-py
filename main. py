# ============ رفع الملفات ============
async def handle_file(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = str(update.effective_user.id)
    u = get_user(uid)
    cost = 0 if u['vip'] else 0.10

    if u['uploads'] >= 3 and not u['vip']:
        await update.message.reply_text("❌ وصلت الحد المجاني (3 ملفات).\n👑 اشترك VIP لرفع غير محدود!", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("👑 ترقية VIP", callback_data="vip")]]))
        return
    if u['balance'] < cost:
        await update.message.reply_text(f"❌ رصيدك لا يكفي! تحتاج ${cost}"); return

    doc = update.message.document or update.message.video or update.message.audio
    photo = update.message.photo[-1] if update.message.photo else None
    file_obj = doc or photo
    if not file_obj:
        return

    code = ''.join(random.choices(string.ascii_letters+string.digits, k=8))
    fname = getattr(file_obj, 'file_name', 'photo.jpg') if doc else 'photo.jpg'

    FILES[code] = {"owner": uid, "file_id": file_obj.file_id, "name": fname, "date": datetime.now().isoformat(), "downloads": 0}
    u['balance'] -= cost
    u['uploads'] += 1
    save_data()

    botname = (await context.bot.get_me()).username
    link = f"https://t.me/{botname}?start=file_{code}"

    await update.message.reply_text(f"✅ **تم الرفع!**\n\n📄 {fname}\n🔗 رابط دائم:\n`{link}`\n\n💵 رصيدك: ${u['balance']:.2f}\nارسل الرابط لأي شخص ليحمل!", parse_mode="Markdown")

