{vip_txt}
👥 دعواتك: {u['refs']} | 📁 ملفاتك: {u['uploads']}

👇 **اختر الخدمة:**
"""
    kb = [
        [InlineKeyboardButton("📁 رفع ملف (استضافة دائمة) 🔥", callback_data="upload")],
        [InlineKeyboardButton("🛒 متجر المتابعين", callback_data="shop"), InlineKeyboardButton("🔐 خزنتي", callback_data="vault")],
        [InlineKeyboardButton("🎁 بونص يومي", callback_data="daily"), InlineKeyboardButton("🔗 رابط دعوتي 1$", callback_data="ref")],
        [InlineKeyboardButton("💎 ترقية VIP - 10$ 👑", callback_data="vip"), InlineKeyboardButton("💵 شحن / سحب", callback_data="wallet")],
        [InlineKeyboardButton("👤 حسابي وملفاتي", callback_data="profile")],
    ]
    if update.effective_user.id == ADMIN_ID:
        kb.append([InlineKeyboardButton("⚙️ لوحة الادمن", callback_data="admin")])

    if update.message:
        await update.message.reply_text(txt, reply_markup=InlineKeyboardMarkup(kb), parse_mode="Markdown")
