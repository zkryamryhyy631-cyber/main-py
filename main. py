# ============ قاعدة البيانات ============
USERS = {}
FILES = {}

def load_data():
    global USERS, FILES
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                USERS = data.get("users", {}) if isinstance(data, dict) and "users" in data else data
                FILES = data.get("files", {}) if isinstance(data, dict) and "files" in data else {}
        except:
            USERS, FILES = {}, {}

def save_data():
    try:
        with open(DATA_FILE, 'w', encoding='utf-8') as f:
            json.dump({"users": USERS, "files": FILES}, f, indent=2, ensure_ascii=False, default=str)
    except Exception as e:
        print(f"Save error {e}")

load_data()

def get_user(uid):
    uid = str(uid)
    if uid not in USERS:
        USERS[uid] = {"balance": 0.50, "vip": False, "expire": None, "refs": 0, "daily": None, "earned": 0, "uploads": 0, "vault": []}
        save_data()
    return USERS[uid]

# ============ البداية ============
async def handle_start_file(update: Update, context: ContextTypes.DEFAULT_TYPE):
    # اذا داخل من رابط ملف
    if context.args and context.args[0].startswith("file_"):
        code = context.args[0].replace("file_", "")
        if code in FILES:
            f = FILES[code]
            f["downloads"] = f.get("downloads", 0) + 1
            save_data()
            await update.message.reply_text(f"📁 **تحميل:** {f['name']}\n👁️ التحميلات: {f['downloads']}")
            try:
                await context.bot.send_document(update.effective_user.id, f["file_id"], caption=f"📄 {f['name']}")
            except:
                await context.bot.send_photo(update.effective_user.id, f["file_id"])
            return
    await start(update, context)

